{
  "name": "profile-stats",
  "version": "1.0.0",
  "private": true,
  "description": "Generates language-share donut charts for a GitHub profile README.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "generate": "node src/index.mjs",
    "generate:sample": "node src/index.mjs --sample",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  }
}
